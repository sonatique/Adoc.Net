# Normalize line endings to LF in the repository for all text files so checkouts are
# byte-identical across Windows/Linux/macOS (the conformance corpus and fixtures are
# compared line-for-line, and CRLF/LF drift produces noisy, OS-specific diffs).
* text=auto eol=lf

# Explicit text types (defensive; covered by text=auto but documents intent).
*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.adoc      text eol=lf
*.html      text eol=lf
*.xml       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.ps1       text eol=lf

# Binary assets must never be line-ending-normalized.
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.pdf       binary
*.ttf       binary
*.otf       binary
*.woff      binary
*.woff2     binary
*.epub      binary
*.zip       binary
