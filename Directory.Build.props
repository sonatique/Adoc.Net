<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Use the latest released C# version, not 'preview'. Preview language features have no
         compatibility guarantee, and shipping a 1.x library built with them is a red flag for
         teams with a no-preview policy. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>


  <!-- NuGet package metadata (shared across all packable projects) -->
  <PropertyGroup>
    <Version>1.0.19</Version>
    <Authors>Sylvain Fasel</Authors>
    <Copyright>Copyright (c) Sylvain Fasel</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sonatique/Adoc.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sonatique/Adoc.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>asciidoc;parser;ast;html;pdf;epub;docbook;documentation;lsp;avalonia;layout</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.0.19: layout super/subscript and PDF symbol-fallback fixes. #71: the layout/Avalonia live preview gains SuperscriptRun/SubscriptRun and now renders ^sup^, ~sub~, and footnote markers as smaller, baseline-shifted text (footnote markers as clickable superscript links) instead of plain inline text. #72: the PDF symbol font-fallback now iterates Unicode codepoints, so non-BMP characters no longer become '??' (one missing-glyph indicator at worst), and a footnote in a table cell no longer disables symbol fallback for the rest of the cell. See CHANGELOG.md.</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Symbol packages for debugging. Embeds portable PDBs in .snupkg files. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- XML documentation for public API surfaces.
       CS1591 (missing XML comment) is suppressed so that TreatWarningsAsErrors
       does not block builds for undocumented members. Documentation is added
       incrementally as API surfaces stabilise. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
