<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Suppress transitive NuGet vulnerability warnings that cannot be fixed
       until upstream packages release patched versions. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xrw6-gwf8-vvr9" />
  </ItemGroup>

  <!-- NuGet package metadata (shared across all packable projects) -->
  <PropertyGroup>
    <Version>1.0.5</Version>
    <Authors>Sylvain Fasel</Authors>
    <Copyright>Copyright (c) Sylvain Fasel</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sonatique/Adoc.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sonatique/Adoc.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>asciidoc;parser;ast;html;pdf;epub;docbook;documentation;lsp;avalonia;layout</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.0.5: Root-cause fix for Avalonia table-column collapse with row-spans (#26). The v1.0.4 cap alone was not enough: weight computation didn't track row-span occupancy, so cells in continuation rows were attributed to the wrong columns, and long-prose content's weight landed on the wrong column entirely. `TableColumnWeights.Compute` now mirrors the renderer's `occupied[]` placement logic. A new `ComputeMinWidthsPixels` adds a per-column min-width floor (longest single word × ~7.5 px) wired into `ColumnDefinition.MinWidth`, so narrow header-only columns no longer collapse to one letter per line when sharing a viewport with prose columns. See CHANGELOG.md.</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Symbol packages for debugging. Embeds portable PDBs in .snupkg files. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- XML documentation for public API surfaces.
       CS1591 (missing XML comment) is suppressed so that TreatWarningsAsErrors
       does not block builds for undocumented members. Documentation is added
       incrementally as API surfaces stabilise. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
