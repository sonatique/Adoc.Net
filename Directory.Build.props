<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Use the latest released C# version, not 'preview'. Preview language features have no
         compatibility guarantee, and shipping a 1.x library built with them is a red flag for
         teams with a no-preview policy. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>


  <!-- NuGet package metadata (shared across all packable projects) -->
  <PropertyGroup>
    <Version>1.0.13</Version>
    <Authors>Sylvain Fasel</Authors>
    <Copyright>Copyright (c) Sylvain Fasel</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sonatique/Adoc.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sonatique/Adoc.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>asciidoc;parser;ast;html;pdf;epub;docbook;documentation;lsp;avalonia;layout</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.0.13: A source-provenance release for editor integration (metadata only — rendered output unchanged). #46: ParseResult.LineOrigins and TryGetLineOrigin map each line of the fully-expanded document back to the file and line the author edits, via a new LineOrigin(SourceFile, SourceLine, IsSynthetic) type; the mapping is produced by the parser and stays correct through include:: expansion (incl. tags=/lines=/leveloffset= filtering and nesting), conditional (ifdef/ifeval) stripping, and front-matter removal. #45: table cells now carry their own per-cell source span (TableCellNode/TableCellLayout.Source) instead of the whole row's range, inline ranges inside cells are absolute document coordinates, and multi-line a| cells carry an absolute range with absolute-numbered nested children. See CHANGELOG.md.</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Symbol packages for debugging. Embeds portable PDBs in .snupkg files. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- XML documentation for public API surfaces.
       CS1591 (missing XML comment) is suppressed so that TreatWarningsAsErrors
       does not block builds for undocumented members. Documentation is added
       incrementally as API surfaces stabilise. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
