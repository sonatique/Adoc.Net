<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Use the latest released C# version, not 'preview'. Preview language features have no
         compatibility guarantee, and shipping a 1.x library built with them is a red flag for
         teams with a no-preview policy. -->
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>


  <!-- NuGet package metadata (shared across all packable projects) -->
  <PropertyGroup>
    <Version>1.0.22</Version>
    <Authors>Sylvain Fasel</Authors>
    <Copyright>Copyright (c) Sylvain Fasel</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sonatique/Adoc.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sonatique/Adoc.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>asciidoc;parser;ast;html;pdf;epub;docbook;documentation;lsp;avalonia;layout</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.0.22: paged Avalonia preview. #79: adds PagedAvaloniaRenderer and PageLayoutOptions to AdocNet.Avalonia — a print-like preview that flows content into fixed-size pages (A4/Letter presets, plus FromPdfPoints to mirror a PdfRenderOptions geometry) without a PDF-rasterizer dependency; RenderPages returns one Border per page and inline source ranges are preserved, so click-to-source still works. Pagination is at block granularity by on-screen measurement, so it approximates rather than matches PDF page breaks. Also adds PageBreakLayout to AdocNet.Layout: LayoutBuilder no longer drops explicit '&lt;&lt;&lt;' page breaks (continuous renderers still ignore them, so existing consumers are unaffected). See CHANGELOG.md.</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Symbol packages for debugging. Embeds portable PDBs in .snupkg files. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- XML documentation for public API surfaces.
       CS1591 (missing XML comment) is suppressed so that TreatWarningsAsErrors
       does not block builds for undocumented members. Documentation is added
       incrementally as API surfaces stabilise. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
