<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- Suppress transitive NuGet vulnerability warnings that cannot be fixed
       until upstream packages release patched versions. -->
  <ItemGroup>
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-xrw6-gwf8-vvr9" />
  </ItemGroup>

  <!-- NuGet package metadata (shared across all packable projects) -->
  <PropertyGroup>
    <Version>1.0.8</Version>
    <Authors>Sylvain Fasel</Authors>
    <Copyright>Copyright (c) Sylvain Fasel</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sonatique/Adoc.Net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/sonatique/Adoc.Net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>asciidoc;parser;ast;html;pdf;epub;docbook;documentation;lsp;avalonia;layout</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>v1.0.8: Lands Phases 3–6 of the WYSIWYG roadmap that PRs #11–#14 nominally merged in May but never actually reached main — the four stacked PRs each used the previous stacked branch as base, so the merge commits sat on the chained branches instead of propagating to main. PR #35 cherry-picked them onto main; this release packages the result. New public `AdocNet.Avalonia.IncrementalAvaloniaRenderer` performs section-level diff-and-splice updates against an existing control tree, mirroring `IncrementalHtmlRenderer`. A new `samples/AdocNet.Avalonia.Editor` runnable demonstrates the full stack: source pane + live preview + toolbar + double-click-into-block editing + right-click context menu with AST-mutation actions that round-trip through the AdocNet.Emitter source-anchored path. See CHANGELOG.md.</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Symbol packages for debugging. Embeds portable PDBs in .snupkg files. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <!-- XML documentation for public API surfaces.
       CS1591 (missing XML comment) is suppressed so that TreatWarningsAsErrors
       does not block builds for undocumented members. Documentation is added
       incrementally as API surfaces stabilise. -->
  <PropertyGroup Condition="'$(IsPackable)' != 'false' and '$(IsTestProject)' != 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
