<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>adocnet</AssemblyName>
    <RootNamespace>AdocNet.Cli</RootNamespace>
    <!-- The CLI emits byte-deterministic, invariant-culture output. Enabling invariant
         globalization keeps that guarantee and lets the tool start on ICU-less images
         (musl/Alpine) without a culture dependency. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>AsciiDoc CLI tool — convert files and directories to HTML, PDF, DocBook, EPUB. Includes watch mode, live preview server, and project configuration.</Description>

    <!-- NuGet tool packaging -->
    <PackageId>AdocNet.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>adocnet</ToolCommandName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdocNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdocNet.Core\AdocNet.Core.csproj" />
    <ProjectReference Include="..\AdocNet.Ast\AdocNet.Ast.csproj" />
    <ProjectReference Include="..\AdocNet.Parser\AdocNet.Parser.csproj" />
    <ProjectReference Include="..\AdocNet.Converters.Html\AdocNet.Converters.Html.csproj" />
    <ProjectReference Include="..\AdocNet.Converters.Pdf\AdocNet.Converters.Pdf.csproj" />
    <ProjectReference Include="..\AdocNet.Converters.DocBook\AdocNet.Converters.DocBook.csproj" />
    <ProjectReference Include="..\AdocNet.Converters.Epub\AdocNet.Converters.Epub.csproj" />
    <ProjectReference Include="..\AdocNet.Converters.Man\AdocNet.Converters.Man.csproj" />
    <ProjectReference Include="..\AdocNet.Converters.Revealjs\AdocNet.Converters.Revealjs.csproj" />
  </ItemGroup>
</Project>
