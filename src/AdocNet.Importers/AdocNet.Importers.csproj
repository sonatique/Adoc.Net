<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AdocNet.Importers</RootNamespace>
    <Description>Markdown, HTML and PDF importers for Adoc.Net: convert to AsciiDoc source with extracted media and a per-document fidelity report.</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Docx importer's escaping rules, shared as source (internal to each assembly). -->
    <Compile Include="..\AdocNet.Importers.Docx\Conversion\AsciidocText.cs" Link="Shared\AsciidocText.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Markdig (BSD-2-Clause): CommonMark + GFM parsing. AngleSharp (MIT): HTML5 parsing.
         PdfPig (Apache-2.0): PDF text, font and image extraction. -->
    <PackageReference Include="Markdig" Version="1.6.0" />
    <PackageReference Include="AngleSharp" Version="1.10.3" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdocNet.Ast\AdocNet.Ast.csproj" />
    <ProjectReference Include="..\AdocNet.Parser\AdocNet.Parser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdocNet.Importers.Tests" />
  </ItemGroup>
</Project>
