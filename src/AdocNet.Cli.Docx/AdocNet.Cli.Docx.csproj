<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>docx2adoc</AssemblyName>
    <RootNamespace>AdocNet.Cli.Docx</RootNamespace>
    <Description>Word (.docx) to AsciiDoc converter built on AdocNet.Importers.Docx.</Description>

    <!-- NuGet tool packaging -->
    <PackageId>AdocNet.Docx</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>docx2adoc</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdocNet.Importers.Docx\AdocNet.Importers.Docx.csproj" />
  </ItemGroup>
</Project>
