<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AdocNet.Converters.Pdf</RootNamespace>
    <Description>PDF renderer for the Adoc.Net library. Pure managed code, no external dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdocNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- FontAwesome 5 Solid + Regular embedded for asciidoctor-pdf admonition
         and inline icon parity. Licensed under the SIL Open Font License 1.1. -->
    <EmbeddedResource Include="Resources\fa-solid.ttf" />
    <EmbeddedResource Include="Resources\fa-regular.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdocNet.Core\AdocNet.Core.csproj" />
    <ProjectReference Include="..\AdocNet.Ast\AdocNet.Ast.csproj" />
  </ItemGroup>
</Project>
