<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework />
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AdocNet.Converters.Pdf</RootNamespace>
    <Description>PDF renderer for the Adoc.Net library. Pure managed code, no external dependencies.</Description>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AdocNet.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <!-- This package embeds Font Awesome fonts; ship their attribution. -->
    <None Include="..\..\NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- FontAwesome 5 Solid + Regular embedded for asciidoctor-pdf admonition
         and inline icon parity. Font under SIL Open Font License 1.1; icon
         designs under CC BY 4.0. See NOTICES.md. -->
    <EmbeddedResource Include="Resources\fa-solid.ttf" />
    <EmbeddedResource Include="Resources\fa-regular.ttf" />
    <!-- DejaVu Sans embedded as an on-demand fallback for glyphs outside WinAnsi
         (arrows incl. ⇒/⇐, check marks, dingbats, geometric shapes, math), so
         special characters render portably with a ToUnicode CMap. Subset per
         document and only embedded when actually used. Bitstream Vera / public
         domain; see NOTICES.md. -->
    <EmbeddedResource Include="Resources\DejaVuSans.ttf" />
    <!-- Symbola embedded as the secondary fallback, consulted only for codepoints
         DejaVu Sans lacks (e.g. SMP symbols like U+1F6C7). Subset per document and
         only embedded when actually used. Public domain (George Douros); see
         NOTICES.md. -->
    <EmbeddedResource Include="Resources\Symbola.ttf" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdocNet.Core\AdocNet.Core.csproj" />
    <ProjectReference Include="..\AdocNet.Ast\AdocNet.Ast.csproj" />
  </ItemGroup>
</Project>
