<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ae="https://github.com/avaloniaui/avaloniaedit"
        x:Class="AdocNet.Avalonia.Editor.MainWindow"
        Title="AdocNet Hybrid Editor"
        Width="1280" Height="800">
  <Grid RowDefinitions="Auto,*,Auto">

    <!-- ┌─ Toolbar ─────────────────────────────────────────────────────────┐ -->
    <Border Grid.Row="0" Padding="6" BorderBrush="#cfcfcf" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Button x:Name="OpenButton"      Content="Open"     Click="OnOpenClick"   ToolTip.Tip="Open .adoc file (Ctrl+O)" />
        <Button x:Name="SaveButton"      Content="Save"     Click="OnSaveClick"   ToolTip.Tip="Save (Ctrl+S)" IsEnabled="False" />
        <Separator Width="8" />

        <Button x:Name="BoldButton"      Content="B"        Click="OnBoldClick"      ToolTip.Tip="Bold (Ctrl+B)"      FontWeight="Bold" />
        <Button x:Name="ItalicButton"    Content="I"        Click="OnItalicClick"    ToolTip.Tip="Italic (Ctrl+I)"    FontStyle="Italic" />
        <Button x:Name="MonoButton"      Content="`M`"      Click="OnMonoClick"      ToolTip.Tip="Monospace (Ctrl+`)" FontFamily="Cascadia Mono,Consolas,monospace" />
        <Separator Width="8" />

        <ComboBox x:Name="HeadingPicker" Width="90"
                  SelectionChanged="OnHeadingChanged"
                  ToolTip.Tip="Heading level">
          <ComboBoxItem Content="(no head.)" />
          <ComboBoxItem Content="H1" />
          <ComboBoxItem Content="H2" />
          <ComboBoxItem Content="H3" />
          <ComboBoxItem Content="H4" />
        </ComboBox>
        <Separator Width="8" />

        <Button x:Name="BulletListButton"  Content="• list"   Click="OnBulletListClick"  ToolTip.Tip="Bullet list" />
        <Button x:Name="NumberedListButton" Content="1. list" Click="OnNumberedListClick" ToolTip.Tip="Numbered list" />
        <Separator Width="8" />

        <Button x:Name="LinkButton"      Content="Link"     Click="OnLinkClick"     ToolTip.Tip="Insert link" />
        <Button x:Name="ImageButton"     Content="Image"    Click="OnImageClick"    ToolTip.Tip="Insert image macro" />
        <Button x:Name="TableButton"     Content="Table"    Click="OnTableClick"    ToolTip.Tip="Insert table skeleton" />
        <Button x:Name="QuoteButton"     Content="Quote"    Click="OnQuoteClick"    ToolTip.Tip="Quote block" />
        <Button x:Name="AdmonitionButton" Content="Note"    Click="OnAdmonitionClick" ToolTip.Tip="Insert NOTE admonition" />
        <Button x:Name="CodeBlockButton" Content="Code"     Click="OnCodeBlockClick" ToolTip.Tip="Insert source code block" />
        <Button x:Name="HrButton"        Content="HR"       Click="OnHrClick"       ToolTip.Tip="Insert thematic break" />
      </StackPanel>
    </Border>

    <!-- ┌─ Source pane │ preview pane ──────────────────────────────────────┐ -->
    <Grid Grid.Row="1" ColumnDefinitions="*,5,*">
      <Border Grid.Column="0" BorderBrush="#cfcfcf" BorderThickness="0,0,1,0">
        <ae:TextEditor x:Name="SourceEditor"
                       FontFamily="Cascadia Mono,Consolas,Menlo,monospace"
                       FontSize="13"
                       ShowLineNumbers="True"
                       WordWrap="False" />
      </Border>

      <GridSplitter Grid.Column="1" Background="#cfcfcf" ResizeDirection="Columns" />

      <ScrollViewer Grid.Column="2" Padding="8">
        <ContentControl x:Name="PreviewHost" />
      </ScrollViewer>
    </Grid>

    <!-- ┌─ Status bar ──────────────────────────────────────────────────────┐ -->
    <Border Grid.Row="2" Padding="6,3" BorderBrush="#cfcfcf" BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <TextBlock x:Name="VersionLabel"   Foreground="Gray" Text="v0" />
        <TextBlock x:Name="LengthLabel"    Foreground="Gray" Text="0 chars" />
        <TextBlock x:Name="ParseTimeLabel" Foreground="Gray" Text="" />
        <TextBlock x:Name="DiagsLabel"     Foreground="Gray" Text="0 diagnostics" />
        <TextBlock x:Name="CaretContextLabel" Foreground="Gray" Text="" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
